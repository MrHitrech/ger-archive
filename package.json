{
  "name": "ger-russian-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "predev": "npm run data:check && node scripts/publish-data.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run data:check && node scripts/publish-data.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "data:import": "node scripts/import-data.mjs",
    "game:extract": "node scripts/extract-game-data.mjs",
    "game:import": "node scripts/import-game-data.mjs",
    "game:images": "node scripts/extract-game-images.mjs",
    "data:check": "node scripts/validate-data.mjs --check",
    "data:report": "node scripts/validate-data.mjs --write",
    "translations:prepare": "node scripts/prepare-translations.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "npm run build && playwright test",
    "format": "prettier --write src scripts tests *.ts package.json README.md docs/data-workflow.md .github/workflows"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.17.1",
    "prettier": "^3.10.1",
    "typescript": "~5.9.0",
    "vite": "^7.2.0"
  }
}
